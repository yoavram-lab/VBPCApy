# MANIFEST.in for vbpca_py

# -----------------------------
# Core source files (Python + C++)
# -----------------------------
recursive-include src *.py *.pyi *.cpp *.h
include src/vbpca_py/py.typed

# -----------------------------
# Top-level metadata
# -----------------------------
include pyproject.toml
include README.md
include LICENSE
include MANIFEST.in
include CITATION.cff
include CHANGELOG.md
include mkdocs.yml
include docs/*.md
recursive-include docs/api *.md
recursive-include docs/concepts *.md
recursive-include docs/gallery *.md
recursive-include docs/getting-started *.md
recursive-include docs/howto *.md
recursive-include docs/javascripts *.js
recursive-include docs/releases *.md
recursive-include docs/tutorials *.md
include scripts/benchmark_study.md
recursive-include scripts *.py
include tools/allocation_counter.c

# -----------------------------
# Tests
# -----------------------------
# Include all lightweight tests
recursive-include tests *.py
include tests/data/legacy_pca_full_dense.mat
include tests/data/legacy_pca_full_missing.mat
include tests/data/legacy_rotate_to_pca.mat
include examples/mixed-missing-table.ipynb
include docs/getting-started/quickstart.md
include docs/tutorials/basic-dense-pca.md
include docs/tutorials/preprocessing-mixed-data.md

# Repository analysis modules and fixed manifests used by the shipped tests.
# Generated results and figures remain outside the source distribution.
recursive-include analysis *.py
recursive-include analysis/trade_study/manifests *.json
prune analysis/results
